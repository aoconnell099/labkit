{
  "settle_ms": 1000,
  "scenes": [
    {
      "name": "motion tokens",
      "reduced_motion": true,
      "steps": [
        {"wait_for": ".btn"},
        {"note": "getComputedStyle(document.querySelector('.btn')).getPropertyValue('--dur-state').trim()", "as": "token"},
        {"note": "getComputedStyle(document.querySelector('.btn')).transitionDuration", "as": "btn"},
        {"expect": "notes.token === '0ms'", "says": "the state duration token is 0ms"},
        {"expect": "notes.btn.split(', ').every(d => parseFloat(d) <= 0.001)", "says": "a button's transitions take at most 1ms"},
        {"expect": "parseFloat(getComputedStyle(document.querySelector('.ctl')).transitionDuration) <= 0.001", "says": "a field's transition takes at most 1ms"}
      ]
    },
    {
      "name": "motion tokens",
      "steps": [
        {"wait_for": ".btn"},
        {"note": "getComputedStyle(document.querySelector('.btn')).getPropertyValue('--dur-state').trim()", "as": "token"},
        {"note": "getComputedStyle(document.querySelector('.btn')).transitionDuration", "as": "btn"},
        {"expect": "notes.token === '180ms'", "says": "the state duration token is 180ms"},
        {"expect": "notes.btn.split(', ').every(d => d === '0.18s')", "says": "a button's transitions take 180ms"}
      ]
    },
    {
      "name": "dark-only theme",
      "width": "phone",
      "steps": [
        {"wait_for": ".frame[data-theme=\"Cool dark\"]", "ms": 5000},
        {"expect": "document.querySelectorAll('.frame[data-theme=\"Cool dark\"]').length === 1 && document.querySelector('.frame[data-theme=\"Cool dark\"]').dataset.mode === 'dark'", "says": "the theme loads, in its dark mode"},
        {"expect": "!document.querySelector('.frame[data-theme=\"Cool dark\"]').textContent.includes('token(s) undefined')", "says": "every token the kit promises resolves in the theme frame"},
        {"click": "#show-both"},
        {"wait_until": "document.querySelectorAll('.frame:not([data-theme])').length === 6", "ms": 5000},
        {"expect": "document.querySelectorAll('.frame:not([data-theme])').length === 6", "says": "show both modes doubled the palette frames"},
        {"expect": "document.querySelectorAll('.frame[data-theme=\"Cool dark\"]').length === 1 && document.querySelectorAll('.frame[data-theme=\"Cool dark\"][data-mode=light]').length === 0", "says": "the gallery never offers the dark-only theme a light mode"},
        {"shot": "both-modes"}
      ]
    },
    {
      "name": "theme audit",
      "width": "phone",
      "steps": [
        {"wait_until": "typeof window.labkitAudit === 'function'", "ms": 5000},
        {"note": "JSON.stringify(window.labkitAudit())", "as": "audit"},
        {"expect": "Object.keys(window.labkitAudit()).length > 0", "says": "the audit reports at least one theme"},
        {"expect": "Object.values(window.labkitAudit()).every(t => Object.values(t).every(f => f.length === 0))", "says": "labkitAudit reports 0 failures"},
        {"expect": "Object.keys(window.labkitAudit()['Cool dark']).join() === 'dark'", "says": "the dark-only theme is audited in dark only"}
      ]
    },
    {
      "name": "full motion",
      "width": "phone",
      "steps": [
        {"wait_for": ".frame[data-theme] .enter", "ms": 5000},
        {"expect": "document.querySelector('.frame[data-theme]').dataset.motion === 'full'", "says": "the theme starts at full"},
        {"note": "(document.querySelector('.frame[data-theme]').scrollIntoView(), true)", "as": "scrolled"},
        {"wait_ms": 700},
        {"shot": "theme-frame"},
        {"note": "(() => { const el = document.querySelector('.frame[data-theme] .enter'); const a = el.getAnimations().find(x => x.animationName === 'labkit-enter'); a.pause(); a.currentTime = 0; return getComputedStyle(el).transform; })()", "as": "start"},
        {"expect": "notes.start === 'matrix(1, 0, 0, 1, 0, 12)'", "says": "under full the rise entrance starts 12px down"},
        {"expect": "document.querySelector('.frame[data-theme] .is-loading').getAnimations().some(a => a.playState === 'running')", "says": "under full the loading pulse runs"}
      ]
    },
    {
      "name": "calm motion",
      "width": "phone",
      "steps": [
        {"wait_for": ".frame[data-theme] .enter", "ms": 5000},
        {"click": "#motion-calm"},
        {"wait_until": "document.querySelector('.frame[data-theme]').dataset.motion === 'calm'", "ms": 5000},
        {"note": "(document.querySelector('.frame[data-theme] .surface').scrollIntoView(), true)", "as": "scrolled"},
        {"wait_ms": 700},
        {"shot": "theme-surface"},
        {"note": "(() => { const el = document.querySelector('.frame[data-theme] .enter'); const a = el.getAnimations().find(x => x.animationName === 'labkit-enter'); a.pause(); a.currentTime = 0; return getComputedStyle(el).transform; })()", "as": "start"},
        {"expect": "notes.start === 'none' || notes.start === 'matrix(1, 0, 0, 1, 0, 0)'", "says": "under calm an entrance moves no distance"},
        {"expect": "document.querySelector('.frame[data-theme] .is-loading').getAnimations().filter(a => a.playState === 'running').length === 0", "says": "under calm the loading state has no running animation"},
        {"expect": "getComputedStyle(document.querySelector('.frame[data-theme] .btn')).getPropertyValue('--dur-state').trim() === '180ms'", "says": "under calm state changes keep the theme's 180ms"},
        {"click": "#motion-off"},
        {"wait_until": "document.querySelector('.frame[data-theme]').dataset.motion === 'off'", "ms": 5000},
        {"expect": "getComputedStyle(document.querySelector('.frame[data-theme] .btn')).getPropertyValue('--dur-state').trim() === '0ms'", "says": "under off the state duration token is 0ms"}
      ]
    },
    {
      "name": "theme motion levels",
      "width": "phone",
      "reduced_motion": true,
      "steps": [
        {"wait_for": ".frame[data-theme] .btn", "ms": 5000},
        {"expect": "document.querySelector('.frame[data-theme]').dataset.motion === 'full' && getComputedStyle(document.querySelector('.frame[data-theme] .btn')).getPropertyValue('--dur-state').trim() === '0ms'", "says": "under full the state duration token is 0ms"},
        {"click": "#motion-calm"},
        {"wait_until": "document.querySelector('.frame[data-theme]').dataset.motion === 'calm'", "ms": 5000},
        {"expect": "getComputedStyle(document.querySelector('.frame[data-theme] .btn')).getPropertyValue('--dur-state').trim() === '0ms'", "says": "under calm the state duration token is 0ms"},
        {"click": "#motion-off"},
        {"wait_until": "document.querySelector('.frame[data-theme]').dataset.motion === 'off'", "ms": 5000},
        {"expect": "getComputedStyle(document.querySelector('.frame[data-theme] .btn')).getPropertyValue('--dur-state').trim() === '0ms'", "says": "under off the state duration token is 0ms"}
      ]
    },
    {
      "name": "chosen themes: audit",
      "width": "phone",
      "steps": [
        {"wait_until": "typeof window.labkitAudit === 'function' && typeof window.labkitRatios === 'function'", "ms": 5000},
        {"click": "#show-both"},
        {"wait_until": "document.querySelectorAll('.frame:not([data-theme])').length === 6", "ms": 5000},

        {"note": "window.labkitRatios('Cold core', 'dark')", "as": "cold_core_dark"},
        {"expect": "Object.keys(window.labkitAudit()['Cold core']).join() === 'dark' && window.labkitModesShown('Cold core') === 'dark'", "says": "Cold core ships dark only, and is shown and audited in dark only"},
        {"expect": "window.labkitAudit()['Cold core'].dark.length === 0", "says": "Cold core dark: 0 audit failures"},

        {"note": "window.labkitRatios('Still violet', 'dark')", "as": "still_violet_dark"},
        {"expect": "Object.keys(window.labkitAudit()['Still violet']).join() === 'dark' && window.labkitModesShown('Still violet') === 'dark'", "says": "Still violet ships dark only, and is shown and audited in dark only"},
        {"expect": "window.labkitAudit()['Still violet'].dark.length === 0", "says": "Still violet dark: 0 audit failures"},

        {"note": "window.labkitRatios('Blue haze', 'dark')", "as": "blue_haze_dark"},
        {"expect": "Object.keys(window.labkitAudit()['Blue haze']).join() === 'dark' && window.labkitModesShown('Blue haze') === 'dark'", "says": "Blue haze ships dark only, and is shown and audited in dark only"},
        {"expect": "window.labkitAudit()['Blue haze'].dark.length === 0", "says": "Blue haze dark: 0 audit failures"},

        {"note": "window.labkitRatios('Banked ember', 'dark')", "as": "banked_ember_dark"},
        {"expect": "Object.keys(window.labkitAudit()['Banked ember']).join() === 'dark' && window.labkitModesShown('Banked ember') === 'dark'", "says": "Banked ember ships dark only, and is shown and audited in dark only"},
        {"expect": "window.labkitAudit()['Banked ember'].dark.length === 0", "says": "Banked ember dark: 0 audit failures"},

        {"note": "window.labkitRatios('Magenta tube', 'dark')", "as": "magenta_tube_dark"},
        {"expect": "Object.keys(window.labkitAudit()['Magenta tube']).join() === 'dark' && window.labkitModesShown('Magenta tube') === 'dark'", "says": "Magenta tube ships dark only, and is shown and audited in dark only"},
        {"expect": "window.labkitAudit()['Magenta tube'].dark.length === 0", "says": "Magenta tube dark: 0 audit failures"},

        {"note": "window.labkitRatios('Rust terminal', 'dark')", "as": "rust_terminal_dark"},
        {"expect": "Object.keys(window.labkitAudit()['Rust terminal']).join() === 'dark' && window.labkitModesShown('Rust terminal') === 'dark'", "says": "Rust terminal ships dark only, and is shown and audited in dark only"},
        {"expect": "window.labkitAudit()['Rust terminal'].dark.length === 0", "says": "Rust terminal dark: 0 audit failures"},

        {"note": "window.labkitRatios('Black glint', 'dark')", "as": "black_glint_dark"},
        {"expect": "Object.keys(window.labkitAudit()['Black glint']).join() === 'dark' && window.labkitModesShown('Black glint') === 'dark'", "says": "Black glint ships dark only, and is shown and audited in dark only"},
        {"expect": "window.labkitAudit()['Black glint'].dark.length === 0", "says": "Black glint dark: 0 audit failures"}
      ]
    },
    {
      "name": "chosen themes: reduced motion",
      "width": "phone",
      "reduced_motion": true,
      "steps": [
        {"wait_until": "typeof window.labkitToken === 'function'", "ms": 5000},

        {"expect": "window.labkitToken('Cold core', '--dur-state') === '0ms'", "says": "Cold core: with reduce motion on, the state duration token is 0ms"},
        {"note": "window.labkitShow('Cold core')", "as": "cold_core_shown"},
        {"shot": "cold-core"},

        {"expect": "window.labkitToken('Still violet', '--dur-state') === '0ms'", "says": "Still violet: with reduce motion on, the state duration token is 0ms"},
        {"note": "window.labkitShow('Still violet')", "as": "still_violet_shown"},
        {"shot": "still-violet"},

        {"expect": "window.labkitToken('Blue haze', '--dur-state') === '0ms'", "says": "Blue haze: with reduce motion on, the state duration token is 0ms"},
        {"note": "window.labkitShow('Blue haze')", "as": "blue_haze_shown"},
        {"shot": "blue-haze"},

        {"expect": "window.labkitToken('Banked ember', '--dur-state') === '0ms' && window.labkitToken('Banked ember', '--dur-enter') === '0ms'", "says": "Banked ember: with reduce motion on, the state duration token is 0ms (it is 0ms under full too), and so is the entrance"},
        {"note": "window.labkitShow('Banked ember')", "as": "banked_ember_shown"},
        {"shot": "banked-ember"},

        {"expect": "window.labkitToken('Magenta tube', '--dur-state') === '0ms'", "says": "Magenta tube: with reduce motion on, the state duration token is 0ms"},
        {"note": "window.labkitShow('Magenta tube')", "as": "magenta_tube_shown"},
        {"shot": "magenta-tube"},

        {"expect": "window.labkitToken('Rust terminal', '--dur-state') === '0ms'", "says": "Rust terminal: with reduce motion on, the state duration token is 0ms"},
        {"note": "window.labkitShow('Rust terminal')", "as": "rust_terminal_shown"},
        {"shot": "rust-terminal"},

        {"expect": "window.labkitToken('Black glint', '--dur-state') === '0ms'", "says": "Black glint: with reduce motion on, the state duration token is 0ms"},
        {"note": "window.labkitShow('Black glint')", "as": "black_glint_shown"},
        {"shot": "black-glint"}
      ]
    },
    {
      "name": "chosen themes: calm",
      "width": "phone",
      "steps": [
        {"wait_until": "typeof window.labkitEnterStart === 'function'", "ms": 5000},

        {"expect": "window.labkitToken('Cold core', '--dur-state') === '20ms' && window.labkitToken('Cold core', '--dur-enter') === '870ms'", "says": "Cold core: under full its own 20ms and 870ms land"},
        {"expect": "window.labkitToken('Still violet', '--dur-state') === '180ms' && window.labkitToken('Still violet', '--dur-enter') === '1190ms'", "says": "Still violet: under full its own 180ms and 1190ms land"},
        {"expect": "window.labkitToken('Blue haze', '--dur-state') === '180ms' && window.labkitToken('Blue haze', '--dur-enter') === '1200ms'", "says": "Blue haze: under full its own 180ms and 1200ms land"},
        {"expect": "window.labkitToken('Banked ember', '--dur-state') === '0ms' && window.labkitToken('Banked ember', '--dur-enter') === '1170ms'", "says": "Banked ember: under full its own 0ms and 1170ms land"},
        {"expect": "window.labkitToken('Magenta tube', '--dur-state') === '30ms' && window.labkitToken('Magenta tube', '--dur-enter') === '1200ms'", "says": "Magenta tube: under full its own 30ms and 1200ms land"},
        {"expect": "window.labkitToken('Rust terminal', '--dur-state') === '30ms' && window.labkitToken('Rust terminal', '--dur-enter') === '1210ms'", "says": "Rust terminal: under full its own 30ms and 1210ms land"},
        {"expect": "window.labkitToken('Black glint', '--dur-state') === '180ms' && window.labkitToken('Black glint', '--dur-enter') === '1160ms'", "says": "Black glint: under full its own 180ms and 1160ms land"},

        {"click": "#motion-calm"},
        {"wait_until": "Array.from(document.querySelectorAll('.frame[data-theme]')).every(f => f.dataset.motion === 'calm')", "ms": 5000},

        {"expect": "['none', 'matrix(1, 0, 0, 1, 0, 0)'].includes(window.labkitEnterStart('Cold core'))", "says": "Cold core: under calm an entrance moves no distance"},
        {"expect": "['none', 'matrix(1, 0, 0, 1, 0, 0)'].includes(window.labkitEnterStart('Still violet'))", "says": "Still violet: under calm an entrance moves no distance"},
        {"expect": "['none', 'matrix(1, 0, 0, 1, 0, 0)'].includes(window.labkitEnterStart('Blue haze'))", "says": "Blue haze: under calm an entrance moves no distance"},
        {"expect": "['none', 'matrix(1, 0, 0, 1, 0, 0)'].includes(window.labkitEnterStart('Banked ember'))", "says": "Banked ember: under calm an entrance moves no distance"},
        {"expect": "['none', 'matrix(1, 0, 0, 1, 0, 0)'].includes(window.labkitEnterStart('Magenta tube'))", "says": "Magenta tube: under calm an entrance moves no distance"},
        {"expect": "['none', 'matrix(1, 0, 0, 1, 0, 0)'].includes(window.labkitEnterStart('Rust terminal'))", "says": "Rust terminal: under calm an entrance moves no distance"},
        {"expect": "['none', 'matrix(1, 0, 0, 1, 0, 0)'].includes(window.labkitEnterStart('Black glint'))", "says": "Black glint: under calm an entrance moves no distance"}
      ]
    }
  ]
}
